---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { getProjects } from '../../data/projects';
import { types, groups, url, isExternal, installFolder } from '../../data/site';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getProjects();
  return projects.map((p) => ({ params: { type: p.type, slug: p.slug }, props: { project: p } }));
}
const { project } = Astro.props;
const { data, type } = project;
const info = types[type];
const { Content } = await render(project.entry);
const versions = [...data.versions].sort((a: any, b: any) => +b.date - +a.date);
const latest = versions[0];
const mc = [...new Set(versions.flatMap((v: any) => v.mc))] as string[];
const icon = project.icon ? url(project.icon) : url('default-icon.svg');
const header = project.header ? url(project.header) : url('project-placeholder.svg');
const combo = project.types.length > 1;
const comboLabel = project.types.map((t: any) => types[t as keyof typeof types].singular).join(' + ');
const fmt = (d: Date) => d.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'UTC' });
const linkEntries = Object.entries(data.links).filter(([, v]) => v) as [string, string][];
const linkLabels: Record<string, string> = { source: 'Source', issues: 'Issues', discord: 'Discord', donate: 'Donate' };
---
<Base title={data.title} description={data.summary}>
  <div class="project-banner"><img class="project-header-image" src={header} alt="" width="1400" height="420" /></div>
  <div class="container project">
    <div>
      <p class="pack-by" style="margin:0 0 .75rem">{groups[info.group].label} / <a href={url(`${type}/`)}>{info.label}</a></p>
      <div class="project-header">
        <div class="icon-wrap">
          <img class="pack-icon" src={icon} alt="" />
        </div>
        <div>
          <h1>{data.title}</h1>
          <p class="pack-by" style="margin:.25rem 0 .5rem">{data.summary}</p>
          <div class="tags">
            {data.resolution && <span class="chip accent">{data.resolution}</span>}
            {data.loaders.map((l: string) => <span class="chip accent">{l}</span>)}
            {data.categories.map((c: string) => <span class="chip">{c}</span>)}
          </div>
        </div>
      </div>

      {combo && (
        <div class="warning" role="alert">
          <Icon name="alert" size={28} />
          <div>
            <strong>All-in-one: {comboLabel}</strong>
            <p>This download is more than one kind of pack. You must install it in <em>every</em> place below, or parts of it won't work:</p>
            <ul>
              {project.types.map((t: any) => (
                <li><strong>{types[t as keyof typeof types].singular}</strong> → <code>{installFolder[t as keyof typeof installFolder]}</code></li>
              ))}
            </ul>
          </div>
        </div>
      )}

      <div class="tabs" role="tablist">
        <button class="tab" role="tab" aria-selected="true" data-tab="desc">Description</button>
        {data.gallery.length > 0 && <button class="tab" role="tab" aria-selected="false" data-tab="gallery">Gallery</button>}
        <button class="tab" role="tab" aria-selected="false" data-tab="versions">Versions</button>
      </div>

      <div class="panel prose card" id="desc"><Content /></div>

      {data.gallery.length > 0 && (
        <div class="panel gallery" id="gallery" hidden>
          {data.gallery.map((g: any) => (
            <figure><img src={url(g.src)} alt={g.caption ?? ''} loading="lazy" />{g.caption && <figcaption>{g.caption}</figcaption>}</figure>
          ))}
        </div>
      )}

      <div class="panel" id="versions" hidden>
        {versions.map((v: any) => (
          <div class="card version">
            <div>
              <h4>{v.version}</h4>
              <div class="dl"><span>{fmt(v.date)}</span>{v.mc.length > 0 && <span>Minecraft {v.mc.join(', ')}</span>}</div>
              {v.changelog && <p class="pack-summary" style="margin-bottom:0">{v.changelog}</p>}
            </div>
            <a class="btn primary" href={url(v.file)} download={isExternal(v.file) ? undefined : ''}><Icon name="download" size={18} /> Download</a>
          </div>
        ))}
      </div>
    </div>

    <aside class="side">
      <div class="card">
        <a class="btn primary" href={url(latest.file)} download={isExternal(latest.file) ? undefined : ''}><Icon name="download" size={18} /> Download {latest.version}</a>
      </div>
      {mc.length > 0 && (
        <div class="card">
          <h3>Compatibility</h3>
          <div class="tags">{mc.map((v) => <span class="chip">{v}</span>)}</div>
        </div>
      )}
      <div class="card">
        <h3>Details</h3>
        <div class="dl" style="flex-direction:column">
          <span>Type: {comboLabel}</span>
          <span>Author: {data.author}</span>
          {data.resolution && <span>Resolution: {data.resolution}</span>}
          <span>Updated: {fmt(latest.date)}</span>
        </div>
      </div>
      {linkEntries.length > 0 && (
        <div class="card">
          <h3>Links</h3>
          <div class="dl" style="flex-direction:column">
            {linkEntries.map(([k, v]) => <a href={v}>{linkLabels[k] ?? k}</a>)}
          </div>
        </div>
      )}
    </aside>
  </div>
  <script>
    const tabs = document.querySelectorAll<HTMLElement>('.tab');
    const show = (id: string) => {
      tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.tab === id)));
      document.querySelectorAll<HTMLElement>('.panel').forEach((p) => (p.hidden = p.id !== id));
    };
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.tab!)));
    const h = location.hash.slice(1);
    if (['gallery', 'versions'].includes(h) && document.getElementById(h)) show(h);
  </script>
</Base>
