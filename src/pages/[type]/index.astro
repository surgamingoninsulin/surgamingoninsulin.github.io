---
// One page per section: /resourcepacks/, /datapacks/, /plugins/, /mods/
import Base from '../../layouts/Base.astro';
import Browse from '../../components/Browse.astro';
import { types, typeList, type TypeKey } from '../../data/site';

export function getStaticPaths() {
  return typeList.map((t) => ({ params: { type: t.key }, props: { type: t.key as TypeKey } }));
}
const { type } = Astro.props;
---
<Base title={types[type].label} description={types[type].description}>
  <Browse type={type} />
</Base>
