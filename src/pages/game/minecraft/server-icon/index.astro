---
import SgoiLayout from '../../../../layouts/SgoiLayout.astro';
import McBrand from '../../../../components/McBrand.astro';
import McServerCard from '../../../../components/McServerCard.astro';
import { t } from '../../../../i18n/server';
---

<SgoiLayout titleKey="mc.icon.pageTitle" descriptionKey="mc.icon.metaDescription" active="mc-server-icon" texts={['mc']}>
  <McBrand slot="brand" tool="mc-server-icon" keys="mc.icon" />

  <section class="py-4 text-center" data-reveal>
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl" data-i18n="mc.icon.title">{t('mc.icon.title')}</h1>
    <p class="mt-2 text-lg opacity-70" data-i18n="mc.icon.tagline">{t('mc.icon.tagline')}</p>
  </section>

  <section class="frost rounded-box mx-auto w-full max-w-3xl p-5" data-reveal>
    <label id="drop" class="drop" tabindex="0">
      <input id="file" type="file" accept="image/*" hidden />
      <svg viewBox="0 0 24 24" width="38" height="38" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2" /><circle cx="9" cy="9" r="2" /><path d="m21 15-3.1-3.1a2 2 0 0 0-2.8 0L6 21" /></svg>
      <strong data-i18n="mc.icon.upload">{t('mc.icon.upload')}</strong>
      <span id="file-name" class="text-sm" data-i18n="mc.icon.hint">{t('mc.icon.hint')}</span>
    </label>

    <div class="mt-5 grid gap-4 sm:grid-cols-2">
      <fieldset class="fieldset">
        <legend class="fieldset-legend" data-i18n="mc.icon.fit">{t('mc.icon.fit')}</legend>
        <select id="fit" class="select w-full">
          <option value="cover" data-i18n="mc.icon.fitCover">{t('mc.icon.fitCover')}</option>
          <option value="contain" data-i18n="mc.icon.fitContain">{t('mc.icon.fitContain')}</option>
          <option value="stretch" data-i18n="mc.icon.fitStretch">{t('mc.icon.fitStretch')}</option>
        </select>
      </fieldset>
      <fieldset class="fieldset">
        <legend class="fieldset-legend" data-i18n="mc.icon.scaling">{t('mc.icon.scaling')}</legend>
        <select id="scaling" class="select w-full">
          <option value="smooth" data-i18n="mc.icon.smooth">{t('mc.icon.smooth')}</option>
          <option value="pixel" data-i18n="mc.icon.pixel">{t('mc.icon.pixel')}</option>
        </select>
      </fieldset>
    </div>
  </section>

  <section class="space-y-4 text-center" data-reveal>
    <div>
      <h2 class="text-xl font-bold" data-i18n="mc.icon.preview">{t('mc.icon.preview')}</h2>
      <p class="text-sm opacity-70" data-i18n="mc.icon.previewNote">{t('mc.icon.previewNote')}</p>
    </div>
    <McServerCard id="card" players="0/20" />
    <div class="flex items-center justify-center gap-6">
      <canvas id="out" width="64" height="64" class="rounded border border-base-300" style="image-rendering: pixelated; width: 128px; height: 128px; background: repeating-conic-gradient(#8884 0 25%, transparent 0 50%) 0 0 / 16px 16px;"></canvas>
      <div class="text-left text-sm">
        <div class="font-mono font-bold">server-icon.png</div>
        <div class="opacity-60">64 × 64 PNG</div>
        <button id="download" class="btn btn-primary mt-3" type="button" disabled>
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
          <span data-i18n="mc.icon.download">{t('mc.icon.download')}</span>
        </button>
      </div>
    </div>
    <p class="mx-auto max-w-xl text-sm opacity-60" data-i18n-html="mc.icon.howTo" set:html={t('mc.icon.howTo')} />
  </section>
</SgoiLayout>

<script>
  import '../../../../scripts/minecraft/server-icon.ts';
</script>
