---
import SgoiLayout from '../../../../layouts/SgoiLayout.astro';
import McBrand from '../../../../components/McBrand.astro';
import McServerCard from '../../../../components/McServerCard.astro';
import { t } from '../../../../i18n/server';
---

<SgoiLayout titleKey="mc.info.pageTitle" descriptionKey="mc.info.metaDescription" active="mc-server-info" texts={['mc']}>
  <McBrand slot="brand" tool="mc-server-info" keys="mc.info" />

  <section class="py-4 text-center" data-reveal>
    <h1 class="text-4xl font-extrabold tracking-tight sm:text-5xl" data-i18n="mc.info.title">{t('mc.info.title')}</h1>
    <p class="mt-2 text-lg opacity-70" data-i18n="mc.info.tagline">{t('mc.info.tagline')}</p>
  </section>

  <form id="ping-form" class="mx-auto flex w-full max-w-2xl flex-col gap-3 sm:flex-row" data-reveal>
    <div class="join flex-none" role="radiogroup" aria-label="Edition">
      <input class="join-item btn btn-sm h-12" type="radio" name="edition" value="java" aria-label="Java" checked />
      <input class="join-item btn btn-sm h-12" type="radio" name="edition" value="bedrock" aria-label="Bedrock" />
    </div>
    <label class="input h-12 flex-1">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true" class="opacity-60"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      <input id="address" type="text" class="grow" spellcheck="false" autocomplete="off" autocapitalize="off" placeholder={t('mc.info.placeholder')} data-i18n-attr="placeholder:mc.info.placeholder" />
    </label>
    <button class="btn btn-primary h-12" type="submit" data-i18n="mc.info.check">{t('mc.info.check')}</button>
  </form>

  <p id="status" class="min-h-6 text-center text-sm opacity-70" aria-live="polite"></p>

  <div data-reveal>
    <McServerCard id="card" players="0/0" />
  </div>

  <section id="details" class="frost rounded-box mx-auto w-full max-w-3xl space-y-5 p-5" hidden>
    <dl id="facts" class="mc-kv text-sm"></dl>

    <div id="players-wrap" hidden>
      <h2 class="mb-2 text-sm font-bold" data-i18n="mc.info.playersOnline">{t('mc.info.playersOnline')}</h2>
      <div id="players" class="flex flex-wrap gap-2"></div>
    </div>

    <div id="extras-wrap" hidden>
      <h2 id="extras-title" class="mb-2 text-sm font-bold"></h2>
      <div id="extras" class="flex flex-wrap gap-2"></div>
    </div>
  </section>

  <section class="mx-auto w-full max-w-xl text-center" data-reveal>
    <h2 class="mb-2 text-sm font-bold" data-i18n="mc.info.share">{t('mc.info.share')}</h2>
    <div class="join w-full">
      <input id="share" class="input join-item flex-1 font-mono text-xs" readonly />
      <button id="copy" class="btn join-item" type="button" data-i18n="mc.common.copy">{t('mc.common.copy')}</button>
    </div>
  </section>
</SgoiLayout>

<script>
  import '../../../../scripts/minecraft/server-info.ts';
</script>
