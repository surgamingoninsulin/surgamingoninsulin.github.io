---
import { render } from 'astro:content';
import Base from '../../../layouts/Base.astro';
import { getProjectTools } from '../../../data/projects';
import { url, isExternal } from '../../../data/site';
import Icon from '../../../components/Icon.astro';

export async function getStaticPaths() {
  const projects = await getProjectTools();
  return projects.map((project) => ({ params: { slug: project.slug }, props: { project } }));
}
const { project } = Astro.props;
const { data } = project;
const { Content } = await render(project.entry);
const versions = [...data.versions].sort((a: any, b: any) => +b.date - +a.date);
const latest = versions[0];
const icon = project.icon ? url(project.icon) : url('project-placeholder.svg');
---
<Base title={data.title} description={data.summary}>
  <article class="project-detail">
    <div class="project-detail-header">
      <img class="project-header-image" src={url(project.header || 'project-placeholder.svg')} alt="" width="1400" height="420" />
      <a class="project-back-link" href={url('other-projects/')} aria-label="Back to Projects" title="Back to Projects"><Icon name="arrow-left" size={32} /></a>
      <div class="container project-detail-heading"><span class="chip accent">Project</span><h1>{data.title}</h1><p>{data.summary}</p></div>
    </div>
    <div class="container project-detail-grid">
      <section class="card prose"><h2 style="margin-top:0">About this project</h2><Content /></section>
      <aside class="card project-detail-side">
        <h2>Project details</h2>
        <dl><dt>Version</dt><dd>{latest.version}</dd>{data.links?.source && <><dt>Repository</dt><dd><a href={data.links.source}>GitHub</a></dd></>}{data.links?.issues && <><dt>Issues</dt><dd><a href={data.links.issues}>Report an issue</a></dd></>}</dl>
        <a class="btn primary" href={url(latest.file)} download={isExternal(latest.file) ? undefined : ''}><Icon name="download" size={18} /> Download</a>
      </aside>
    </div>
  </article>
</Base>
