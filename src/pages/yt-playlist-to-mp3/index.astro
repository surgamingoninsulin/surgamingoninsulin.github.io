---
import SgoiLayout from '../../layouts/SgoiLayout.astro';
import { t } from '../../i18n/server';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
---

<SgoiLayout titleKey="yt.pageTitle" descriptionKey="yt.metaDescription" active="yt-mp3" texts={['yt']}>
  <a slot="brand" href={`${base}yt-playlist-to-mp3/`} class="group flex min-w-0 items-center gap-3">
    <svg class="yt-logo flex-none transition-transform duration-300 group-hover:scale-110" viewBox="0 0 28 20" width="40" height="28" aria-hidden="true"><path fill="#FF0000" d="M27.4 3.1A3.5 3.5 0 0 0 24.9.6C22.7 0 14 0 14 0S5.3 0 3.1.6A3.5 3.5 0 0 0 .6 3.1C0 5.3 0 10 0 10s0 4.7.6 6.9a3.5 3.5 0 0 0 2.5 2.5C5.3 20 14 20 14 20s8.7 0 10.9-.6a3.5 3.5 0 0 0 2.5-2.5c.6-2.2.6-6.9.6-6.9s0-4.7-.6-6.9z" /><path fill="#FFFFFF" d="M11.2 14.3 18.4 10l-7.2-4.3z" /></svg>
    <span class="min-w-0">
      <span class="block text-lg font-extrabold leading-tight tracking-tight sm:text-2xl">
        <span class="yt">Youtube</span>{" "}<span class="brand-gradient">Playlist</span>{" "}<span class="text-primary">→</span>{" "}<span class="brand-gradient">.MP3</span>
      </span>
      <span class="hidden items-center gap-2 text-xs opacity-60 sm:flex">
        <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span data-i18n="yt.tagline">{t('yt.tagline')}</span>
      </span>
    </span>
  </a>

  <button slot="actions" id="open-settings" class="btn btn-ghost btn-sm gap-2" type="button" title={t('yt.connection')} data-i18n-attr="title:yt.connection">
    <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 .5C5.7.5.5 5.7.5 12a11.5 11.5 0 0 0 7.9 10.9c.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.4-3.9-1.4-.5-1.3-1.3-1.7-1.3-1.7-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.2-1.3-5.2-5.7 0-1.3.4-2.3 1.2-3.1-.1-.3-.5-1.5.1-3 0 0 1-.3 3.2 1.2a11 11 0 0 1 5.8 0c2.2-1.5 3.2-1.2 3.2-1.2.6 1.6.2 2.8.1 3 .7.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.1v3.2c0 .3.2.7.8.6A11.5 11.5 0 0 0 23.5 12C23.5 5.7 18.3.5 12 .5z" /></svg>
    <span id="conn-label" class="hidden sm:inline">{t('yt.connect')}</span>
  </button>

  <section id="add" class="frost rounded-box p-5" data-reveal>
    <h2 class="mb-4 flex items-center gap-3 text-lg font-bold"><span class="num">1</span> <span data-i18n="yt.add.title">{t('yt.add.title')}</span></h2>
    <div class="grid items-stretch gap-4 md:grid-cols-[1fr_auto_1fr]">
      <label id="drop" class="drop" tabindex="0">
        <input id="file" type="file" multiple hidden />
        <svg viewBox="0 0 24 24" width="38" height="38" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" /><path d="M14 3v5h5M12 18v-6M9 15l3-3 3 3" /></svg>
        <strong data-i18n="yt.add.click">{t('yt.add.click')}</strong>
        <span class="text-sm" data-i18n="yt.add.hint">{t('yt.add.hint')}</span>
      </label>

      <div class="divider md:divider-horizontal text-xs uppercase opacity-60" data-i18n="yt.add.or">{t('yt.add.or')}</div>

      <div class="flex flex-col gap-2">
        <label for="paste" class="font-semibold" data-i18n="yt.add.paste">{t('yt.add.paste')}</label>
        <textarea id="paste" class="textarea w-full flex-1 font-mono text-sm" rows="6" spellcheck="false" placeholder={t('yt.add.placeholder')} data-i18n-attr="placeholder:yt.add.placeholder"></textarea>
        <div class="flex items-center justify-end gap-3">
          <span class="text-xs opacity-60"><kbd class="kbd kbd-xs">Ctrl</kbd> + <kbd class="kbd kbd-xs">Enter</kbd></span>
          <button id="add-pasted" class="btn btn-primary btn-sm" type="button" disabled data-i18n="yt.add.button">{t('yt.add.button')}</button>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-2">
    <div id="choose" class="frost rounded-box flex flex-col overflow-hidden" data-reveal>
      <div class="flex items-center gap-2 border-b border-base-300 px-4 py-3">
        <h2 class="flex items-center gap-3 font-bold"><span class="num">2</span> <span data-i18n="yt.choose.title">{t('yt.choose.title')}</span></h2>
        <span id="link-count" class="badge badge-sm badge-ghost mr-auto">0</span>
        <label class="flex cursor-pointer items-center gap-2 text-sm"><input id="select-all" type="checkbox" class="checkbox checkbox-sm checkbox-primary" checked /> <span data-i18n="yt.choose.all">{t('yt.choose.all')}</span></label>
        <button id="clear" class="btn btn-ghost btn-xs" type="button" data-i18n="common.clear">{t('common.clear')}</button>
      </div>
      <ul id="links" class="items" data-empty={t('yt.choose.empty')} data-i18n-attr="data-empty:yt.choose.empty"></ul>
      <div class="flex flex-wrap items-center gap-3 border-t border-base-300 px-4 py-3">
        <label class="flex items-center gap-2 text-sm opacity-80"><span data-i18n="yt.choose.quality">{t('yt.choose.quality')}</span>
          <select id="bitrate" class="select select-sm w-auto">
            <option value="128">128 kbps</option>
            <option value="192" selected>192 kbps</option>
            <option value="256">256 kbps</option>
            <option value="320">320 kbps</option>
          </select>
        </label>
        <button id="go" class="go btn btn-primary flex-1" type="button" disabled>{t('yt.choose.convert')}</button>
      </div>
    </div>

    <div id="downloads" class="frost rounded-box flex flex-col overflow-hidden" data-reveal>
      <div class="flex items-center gap-2 border-b border-base-300 px-4 py-3">
        <h2 class="flex items-center gap-3 font-bold"><span class="num">3</span> <span data-i18n="yt.downloads.title">{t('yt.downloads.title')}</span></h2>
        <span id="run-count" class="badge badge-sm badge-ghost mr-auto">0</span>
        <button id="clear-runs" class="btn btn-ghost btn-xs" type="button" title={t('yt.downloads.clearTitle')} data-i18n-attr="title:yt.downloads.clearTitle" data-i18n="common.clear">{t('common.clear')}</button>
        <button id="refresh" class="btn btn-ghost btn-xs" type="button" data-i18n="yt.downloads.refresh">{t('yt.downloads.refresh')}</button>
      </div>
      <ul id="runs" class="items" data-empty={t('yt.downloads.empty')} data-i18n-attr="data-empty:yt.downloads.empty"></ul>
    </div>
  </section>

  <p id="status" class="min-h-6 text-center text-sm opacity-70" role="status" aria-live="polite"></p>

  <section id="how" class="space-y-4 pt-4" data-reveal>
    <h2 class="text-center text-2xl font-extrabold tracking-tight" data-i18n="yt.how.title">{t('yt.how.title')}</h2>
    <div class="grid gap-4 md:grid-cols-3">
      <div class="frost rounded-box p-5 transition-transform duration-300 hover:-translate-y-1">
        <div class="mb-3 inline-grid size-11 place-items-center rounded-xl bg-primary/15 text-primary">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.5.5l3-3a5 5 0 0 0-7-7l-1.7 1.7" /><path d="M14 11a5 5 0 0 0-7.5-.5l-3 3a5 5 0 0 0 7 7l1.7-1.7" /></svg>
        </div>
        <h3 class="font-bold" data-i18n="yt.how.addTitle">{t('yt.how.addTitle')}</h3>
        <p class="mt-1 text-sm opacity-70" data-i18n="yt.how.addText">{t('yt.how.addText')}</p>
      </div>
      <div class="frost rounded-box p-5 transition-transform duration-300 hover:-translate-y-1">
        <div class="mb-3 inline-grid size-11 place-items-center rounded-xl bg-secondary/15 text-secondary">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3" /><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z" /></svg>
        </div>
        <h3 class="font-bold" data-i18n="yt.how.convertTitle">{t('yt.how.convertTitle')}</h3>
        <p class="mt-1 text-sm opacity-70" data-i18n="yt.how.convertText">{t('yt.how.convertText')}</p>
      </div>
      <div class="frost rounded-box p-5 transition-transform duration-300 hover:-translate-y-1">
        <div class="mb-3 inline-grid size-11 place-items-center rounded-xl bg-accent/15 text-accent">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3" /></svg>
        </div>
        <h3 class="font-bold" data-i18n="yt.how.zipTitle">{t('yt.how.zipTitle')}</h3>
        <p class="mt-1 text-sm opacity-70" data-i18n="yt.how.zipText">{t('yt.how.zipText')}</p>
      </div>
    </div>
  </section>

  <!-- ============ GitHub connection (production only) ============ -->
  <dialog slot="after" id="settings" class="modal">
    <div class="modal-box max-w-xl">
      <form method="dialog" class="flex flex-col gap-4">
        <h2 class="text-xl font-bold" data-i18n="yt.connection">{t('yt.connection')}</h2>
        <p class="text-sm opacity-70" data-i18n="yt.settings.intro">{t('yt.settings.intro')}</p>
        <p id="repo-item" class="text-sm" hidden>
          <a id="repo-link" class="link link-primary" href="#" target="_blank" rel="noopener"><span data-i18n="yt.githubRepo">{t('yt.githubRepo')}</span> ↗</a>
        </p>

        <label class="flex flex-col gap-1 text-sm"><span data-i18n="yt.settings.repo">{t('yt.settings.repo')}</span>
          <input id="cfg-repo" class="input w-full font-mono" placeholder="owner/repo" spellcheck="false" autocomplete="off" />
        </label>
        <label class="flex flex-col gap-1 text-sm"><span data-i18n="yt.settings.token">{t('yt.settings.token')}</span>
          <input id="cfg-token" class="input w-full font-mono" type="password" placeholder="github_pat_…" spellcheck="false" autocomplete="off" />
        </label>

        <div class="collapse collapse-arrow bg-base-200">
          <input type="checkbox" />
          <div class="collapse-title text-sm font-semibold" data-i18n="yt.settings.tokenHowTo">{t('yt.settings.tokenHowTo')}</div>
          <div class="collapse-content text-sm opacity-80">
            <ol class="list-decimal space-y-1 pl-5" data-i18n-html="yt.settings.tokenHowTo" set:html={t('yt.settings.tokenHowTo')} />
          </div>
        </div>
        <div class="collapse collapse-arrow bg-base-200">
          <input type="checkbox" />
          <div class="collapse-title text-sm font-semibold" data-i18n="yt.settings.cookies">{t('yt.settings.cookies')}</div>
          <div class="collapse-content text-sm opacity-80">
            <ol class="list-decimal space-y-1 pl-5" data-i18n-html="yt.settings.cookies" set:html={t('yt.settings.cookies')} />
          </div>
        </div>

        <p id="cfg-result" class="cfg-result"></p>
        <div class="flex flex-wrap items-center gap-2">
          <button id="cfg-test" class="btn btn-ghost btn-sm" type="button" data-i18n="yt.settings.test">{t('yt.settings.test')}</button>
          <span class="flex-1"></span>
          <button value="cancel" class="btn btn-ghost btn-sm" data-i18n="common.cancel">{t('common.cancel')}</button>
          <button id="save" value="save" class="btn btn-primary btn-sm" data-i18n="common.save">{t('common.save')}</button>
        </div>
      </form>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
  </dialog>
</SgoiLayout>

<script>
  import '../../scripts/app.ts';
</script>
