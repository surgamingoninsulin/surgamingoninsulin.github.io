---
// A dropdown in the side menu (e.g. Game → Minecraft → tools), nested like
// stairs. Open when it holds the current page. Styles: .side-tree in global.css.
import { branchHas, isActive, MENU_ICONS, type MenuBranch } from '../../shared/sgoi';
import { t } from '../i18n/server';

interface Props {
  branch: MenuBranch;
  /** Tool id of the current page. */
  active?: string;
  level?: number;
}
const { branch, active, level = 0 } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const open = branchHas(branch, active);
---

<details class="side-tree" open={open} style={`--lvl:${level}`} data-branch={branch.id}>
  <summary class="side-branch">
    <span class="tool-icon" set:html={MENU_ICONS[branch.id] ?? ''} />
    <span class="flex-1" data-i18n={`hub.menu.${branch.id}`}>{t(`hub.menu.${branch.id}`)}</span>
    <svg class="side-chevron" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6" /></svg>
  </summary>
  <div class="side-tree-body">
    {branch.children.map((child) => <Astro.self branch={child} active={active} level={level + 1} />)}
    {branch.tools.length > 0 && (
      <ul class="menu side-leaves w-full gap-1 p-0" style={`--lvl:${level + 1}`}>
        {branch.tools.map((tool) => (
          <li>
            <a
              href={`${base}${tool.path}`}
              class:list={{ 'menu-active': isActive(tool, active) }}
              aria-current={tool.id === active ? 'page' : undefined}
              title={t(`hub.tools.${tool.id}.blurb`)}
              data-i18n-attr={`title:hub.tools.${tool.id}.blurb`}
            >
              <span class="tool-icon" set:html={tool.icon} />
              {tool.name}
            </a>
          </li>
        ))}
      </ul>
    )}
  </div>
</details>
