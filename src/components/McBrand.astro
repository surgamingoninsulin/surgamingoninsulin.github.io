---
// Header brand for a Minecraft page: the icon, the page title and, under it,
// where it lives (Minecraft for a tool, Games for the Minecraft page itself).
import '../styles/minecraft.css';
import { allPages } from '../../shared/sgoi';
import { t } from '../i18n/server';

interface Props {
  /** Page id from shared/sgoi.ts (a tool or the mc-hub page). */
  tool: string;
  /** Key prefix of the page texts, e.g. "mc.info" (uses .title). */
  keys: string;
  /** Translation key of the line under the title. */
  sub?: string;
}
const { tool, keys, sub = 'hub.menu.minecraft' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const info = allPages().find((x) => x.id === tool)!;
---

<a href={`${base}${info.path}`} class="group flex min-w-0 items-center gap-3">
  <span class="tool-card-icon transition-transform duration-300 group-hover:scale-110" set:html={info.icon} />
  <span class="min-w-0">
    <span class="brand-gradient block truncate text-lg font-extrabold leading-tight tracking-tight sm:text-2xl" data-i18n={`${keys}.title`}>{t(`${keys}.title`)}</span>
    <span class="hidden text-xs opacity-60 sm:block" data-i18n={sub}>{t(sub)}</span>
  </span>
</a>

<script>
  // Every Minecraft page: now and then a random mob peeks in (click it!).
  import { startMobVisits } from '../scripts/minecraft/creeper';
  startMobVisits(document.querySelector<HTMLElement>('.drawer-content'));
</script>
