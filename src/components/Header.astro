---
import { site, groupList, typesInGroup, url } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname;
---
<header class="header">
  <div class="container">
    <a class="brand" href={url('')}>
      <img src={url('pixelith-logo.png')} alt="" width="30" height="30" />
      {site.name}
    </a>
    <nav class="nav" id="nav" aria-label="Main">
      <a href={url('')} aria-current={path === url('') ? 'page' : undefined}>Home</a>

      <!-- One hover (and keyboard focus) dropdown per group. Add a group in data/site.ts and its
           types show up here automatically -- this is the only place a new section needs wiring. -->
      {groupList.map((g) => {
        const items = typesInGroup(g.key);
        const active = items.some((t) => path.startsWith(url(`${t.key}/`))) || path.startsWith(url('projects/'));
        return (
          <div class="dropdown">
            <!-- Not a link: clicking it does nothing, the menu opens on hover/focus -->
            <span class="dd-trigger" tabindex="0" role="button" aria-haspopup="true" aria-current={active ? 'page' : undefined}>
              {g.label}
              <Icon name="chevron-down" size={14} />
            </span>
            <div class="dd-menu">
              {items.map((t) => (
                <a href={url(`${t.key}/`)}>
                  <strong>{t.label}</strong>
                  <small>{t.description}</small>
                </a>
              ))}
            </div>
          </div>
        );
      })}

      <a href={url('other-projects/')} aria-current={path.startsWith(url('other-projects/')) ? 'page' : undefined}>Projects</a>

      <span class="nav-spacer" aria-hidden="true"></span>
      <a href={url('about/')} aria-current={path.startsWith(url('about/')) ? 'page' : undefined}>About</a>
    </nav>
    <a class="icon-btn" href={site.github} aria-label="GitHub" title="GitHub">
      <Icon name="github" size={20} />
    </a>
    <button class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
      <Icon name="moon" class="theme-moon" />
      <Icon name="sun" class="theme-sun" />
    </button>
    <button class="icon-btn menu-btn" id="menu-toggle" aria-label="Menu">
      <Icon name="menu" />
    </button>
  </div>
</header>
