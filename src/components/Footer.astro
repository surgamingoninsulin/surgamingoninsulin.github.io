---
import { site, typeList, url } from '../data/site';
---
<footer class="footer">
  <div class="container">
    <div class="foot-brand">
      <img src={url('pixelith-logo.png')} alt="" width="40" height="40" />
      <div><strong>{site.name}</strong><br />{site.tagline}</div>
    </div>
    <div class="links">
      {typeList.map((t) => <a href={url(`${t.key}/`)}>{t.label}</a>)}
      <a href={url('about/')}>About</a>
      <a href={site.github}>GitHub</a>
    </div>
    <p class="disclaimer">
      {site.copyright} ·
      {site.licenses.map((l, i) => <><a href={l.href}>{l.label}</a>{i < site.licenses.length - 1 && ' · '}</>)}
      — free to use and modify, just credit me.
    </p>
    <p class="notice" role="note">{site.disclaimer}</p>
  </div>
</footer>
