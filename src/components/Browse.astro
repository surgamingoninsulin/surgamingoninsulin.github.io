---
// Modrinth-style browse layout: filters on the left, search + sort on top, result list on the right.
// `type` set  -> a section page (only that type, with that type's filters)
// `type` unset -> the "All projects" page (adds a Type filter)
import ProjectCard from './ProjectCard.astro';
import { getProjects } from '../data/projects';
import { types, typeList, url, type TypeKey } from '../data/site';

interface Props { type?: TypeKey; }
const { type } = Astro.props;
const info = type ? types[type] : undefined;
const projects = await getProjects(type);

const uniq = (a: string[]) => [...new Set(a)];
const categories = info ? info.categories : uniq(typeList.flatMap((t) => t.categories));
const loaders = info ? info.loaders : uniq(typeList.flatMap((t) => t.loaders));
const resolutions = info ? info.resolutions : uniq(typeList.flatMap((t) => t.resolutions));
const mcVersions = uniq(projects.flatMap((p) => p.data.versions.flatMap((v: any) => v.mc))).sort().reverse();
const heading = info ? info.label : 'All projects';
---
<div class="container browse">
  <aside class="filters" aria-label="Filters">
    {!info && (
      <div class="card">
        <h3>Type</h3>
        {typeList.map((t) => <label class="check"><input type="checkbox" name="type" value={t.key} />{t.label}</label>)}
      </div>
    )}
    <div class="card">
      <h3>Category</h3>
      {categories.map((c) => <label class="check"><input type="checkbox" name="cat" value={c} />{c}</label>)}
    </div>
    {loaders.length > 0 && (
      <div class="card">
        <h3>{type === 'plugins' ? 'Platform' : 'Loader'}</h3>
        {loaders.map((l) => <label class="check"><input type="checkbox" name="loader" value={l} />{l}</label>)}
      </div>
    )}
    {resolutions.length > 0 && (
      <div class="card">
        <h3>Resolution</h3>
        {resolutions.map((r) => <label class="check"><input type="checkbox" name="res" value={r} />{r}</label>)}
      </div>
    )}
    {mcVersions.length > 0 && (
      <div class="card">
        <h3>Minecraft version</h3>
        <select class="field" id="mc">
          <option value="">Any version</option>
          {mcVersions.map((v) => <option value={v}>{v}</option>)}
        </select>
      </div>
    )}
    <button class="btn" id="reset" type="button">Reset filters</button>
  </aside>

  <section>
    <h1 style="margin-top:0">{heading}</h1>
    {info && <p class="pack-by" style="margin-top:-.5rem">{info.description}</p>}
    <div class="toolbar">
      <input class="field" id="q" type="search" placeholder={`Search ${heading.toLowerCase()}…`} aria-label="Search" />
      <select class="field" id="sort" aria-label="Sort by">
        <option value="new">Sort: Newest</option>
        <option value="name">Sort: Name (A–Z)</option>
      </select>
    </div>
    <div class="count" id="count"></div>
    <div class="results" id="results">
      {projects.map((p) => <ProjectCard project={p} showType={!info} />)}
    </div>
    <div class="empty" id="empty" hidden>
      {projects.length === 0
        ? <>Nothing here yet. See the README for how to add {info ? info.label.toLowerCase() : 'projects'}.</>
        : <>No projects match your filters.</>}
    </div>
  </section>
</div>

<script>
  const $ = <T extends HTMLElement>(s: string) => document.querySelector<T>(s)!;
  const list = $('#results');
  const cards = Array.from(list.querySelectorAll<HTMLElement>('.card'));
  const q = $<HTMLInputElement>('#q');
  const mc = document.querySelector<HTMLSelectElement>('#mc'); // absent when nothing here has Minecraft versions
  const sort = $<HTMLSelectElement>('#sort');
  const checked = (n: string) =>
    Array.from(document.querySelectorAll<HTMLInputElement>(`input[name=${n}]:checked`)).map((i) => i.value);
  const has = (attr: string | undefined, wanted: string[]) =>
    !wanted.length || wanted.some((w) => (attr ?? '').split('|').includes(w));

  function apply() {
    const text = q.value.trim().toLowerCase();
    const types = checked('type'), cats = checked('cat'), loaders = checked('loader'), res = checked('res');
    let shown = 0;
    for (const c of cards) {
      const d = c.dataset;
      const ok =
        (!text || d.title!.includes(text) || d.summary!.includes(text)) &&
        has(d.type, types) && has(d.cats, cats) && has(d.loaders, loaders) && has(d.res, res) &&
        (!mc || !mc.value || d.mc!.split('|').includes(mc.value));
      c.hidden = !ok;
      if (ok) shown++;
    }
    [...cards]
      .sort((a, b) =>
        sort.value === 'name'
          ? a.dataset.title!.localeCompare(b.dataset.title!)
          : Number(b.dataset.date) - Number(a.dataset.date))
      .forEach((c) => list.appendChild(c));
    $('#count').textContent = `${shown} project${shown === 1 ? '' : 's'}`;
    $('#empty').hidden = shown > 0;
  }

  document.querySelectorAll('input, select').forEach((e) => e.addEventListener('input', apply));
  $('#reset').addEventListener('click', () => {
    q.value = ''; if (mc) mc.value = ''; sort.value = 'new';
    document.querySelectorAll<HTMLInputElement>('input[type=checkbox]').forEach((i) => (i.checked = false));
    apply();
  });
  q.value = new URLSearchParams(location.search).get('q') ?? '';
  apply();
</script>
