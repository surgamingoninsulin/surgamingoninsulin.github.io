---
// Page chrome shared by every SGOI Tools page built with Astro: animated
// background, header, side menu listing all tools (from shared/sgoi.ts) and
// footer. The file converter (convert/) has the same chrome in Preact:
// convert/src/ui/components/SiteShell.
//
// Slots: default (page content), "brand" (tool name next to the SGOI badge),
// "actions" (header buttons before the language and theme buttons),
// "after" (dialogs). Side menu and footer are the same on every page.
//
// Texts come from public/lang_support/*.json: rendered in English here, and
// switched in the browser by src/scripts/i18n.ts (see the data-i18n* attributes).
import '../styles/global.css';
import { allPages, COMING_SOON, CREDITS, HUB, isActive, MENU_LINKS, shownTools, sideMenu, TOOL_GROUPS } from '../../shared/sgoi';
import SideBranch from '../components/SideBranch.astro';
import { DICTS, t } from '../i18n/server';

interface Props {
  /** Translation key of the page title. */
  titleKey: string;
  /** Translation key of the meta description. */
  descriptionKey: string;
  /** Tool id from shared/sgoi.ts, highlighted in the side menu. */
  active?: string;
  /**
   * Extra text sections this page's scripts need in every language (e.g. ["yt"]).
   * "common" and "hub" are always included; the rest is left out to keep pages small.
   */
  texts?: string[];
}

const { titleKey, descriptionKey, active, texts = [] } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const year = new Date().getFullYear();
const letters = [...HUB.short];
// "Tools" in "SGOI Tools"; everywhere the "SGOI" part is the animated badge
const nameRest = HUB.suffix;
const by = JSON.stringify({ owner: HUB.owner });
// Embedded for the language switch; "<" is escaped so the JSON cannot close its script tag early.
// Only the sections this page uses, in every language.
const sections = ['_meta', 'common', 'hub', ...texts];
const pageDicts = Object.fromEntries(
  Object.entries(DICTS).map(([code, dict]) => [code, Object.fromEntries(sections.filter((k) => k in dict).map((k) => [k, dict[k]]))]),
);
const dictsJson = JSON.stringify(pageDicts).replace(/</g, '\\u003c');

// ---- search engines and link previews
const canonical = new URL(Astro.url.pathname, Astro.site ?? HUB.url).href;
const siteUrl = new URL(base, Astro.site ?? HUB.url).href;
const tool = allPages().find((x) => x.id === active);
const author = { '@type': 'Person', name: HUB.owner, url: HUB.ownerUrl };
// schema.org data: the home page is the website, a tool page a free web app.
const jsonLd = JSON.stringify(
  tool
    ? {
        '@context': 'https://schema.org',
        '@type': 'WebApplication',
        name: tool.name,
        url: canonical,
        description: t(descriptionKey),
        applicationCategory: 'MultimediaApplication',
        operatingSystem: 'Any (runs in the browser)',
        isAccessibleForFree: true,
        offers: { '@type': 'Offer', price: '0', priceCurrency: 'EUR' },
        author,
        isPartOf: { '@type': 'WebSite', name: HUB.name, url: siteUrl },
      }
    : {
        '@context': 'https://schema.org',
        '@type': 'WebSite',
        name: HUB.name,
        alternateName: [HUB.short, `${HUB.owner} Tools`],
        url: siteUrl,
        description: t(descriptionKey),
        author,
      },
).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-theme="ytdark" data-side="closed">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={t(descriptionKey)} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <title data-i18n={titleKey}>{t(titleKey)}</title>
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow" />
    <meta name="author" content={HUB.owner} />
    <meta name="theme-color" content="#0e0e11" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={HUB.name} />
    <meta property="og:title" content={t(titleKey)} />
    <meta property="og:description" content={t(descriptionKey)} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <script is:inline>
      // Before first paint: restore the chosen theme and enable entrance animations.
      try {
        const t = localStorage.getItem('ytmp3.theme');
        if (t === 'ytlight' || t === 'ytdark') document.documentElement.dataset.theme = t;
        // The side menu is always shown on desktop.
        if (matchMedia('(min-width: 1024px)').matches) document.documentElement.dataset.side = 'open';
        // Another language was chosen: keep the page hidden for a moment until
        // src/scripts/i18n.ts has translated it, instead of flashing English.
        const l = localStorage.getItem('sgoi.lang');
        if (l && l !== 'en_US') {
          document.documentElement.classList.add('i18n-wait');
          setTimeout(() => document.documentElement.classList.remove('i18n-wait'), 1500);
        }
      } catch {}
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) document.documentElement.classList.add('motion');
    </script>
    <script type="application/json" id="sgoi-i18n" set:html={dictsJson}></script>
  </head>
  <body class="min-h-screen">
    <div class="aurora" aria-hidden="true"><span></span><span></span><span></span><span></span></div>

    <div class="drawer lg:drawer-open">
      <input id="nav" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <!-- ============ header ============ -->
        <header class="site-header" data-anim="header">
          <div class="bg-base-100/70 backdrop-blur-xl">
            <div class="mx-auto flex max-w-6xl items-center gap-3 px-4 py-5 lg:px-8">
              <!-- room for the hamburger (it floats above the menu, see below) -->
              <span class="hamburger-space lg:hidden" aria-hidden="true"></span>
              <slot name="brand" />

              <div class="ml-auto flex items-center gap-1">
                <slot name="actions" />
                <button type="button" class="btn btn-ghost btn-sm gap-1.5 px-2" data-lang-switch>
                  <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z" /></svg>
                  <span data-lang-short class="text-xs font-bold">EN</span>
                </button>
                <label class="btn btn-ghost btn-circle swap swap-rotate" title={t('common.theme')} data-i18n-attr="title:common.theme">
                  <input id="theme-toggle" type="checkbox" aria-label={t('common.themeToggle')} data-i18n-attr="aria-label:common.themeToggle" />
                  <svg class="swap-off" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
                  <svg class="swap-on" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
                </label>
              </div>
            </div>
          </div>
          <div class="glow-line"></div>
        </header>

        <!-- ============ main ============ -->
        <main id="top" class="mx-auto w-full max-w-6xl flex-1 space-y-6 px-4 py-8 lg:px-8">
          <slot />
        </main>

        <!-- ============ footer (same on every SGOI page, see convert/src/ui/components/SiteShell) ============ -->
        <footer class="mt-12 bg-base-200/60 backdrop-blur-xl" data-reveal>
          <div class="glow-line"></div>
          <div class="site-footer-grid mx-auto max-w-6xl px-4 py-10 lg:px-8">
            <aside class="footer-about">
              <a href={base} class="sgoi-name text-lg font-extrabold" aria-label={HUB.name}>
                <span class="sgoi-badge" aria-hidden="true">{letters.map((c, i) => <i style={`--i:${i}`}>{c}</i>)}</span>
                <span aria-hidden="true">{nameRest}</span>
              </a>
              <p data-i18n="hub.tagline">{t('hub.tagline')}</p>
            </aside>
            {TOOL_GROUPS.map((group) => (
              <nav>
                <h6 data-i18n={`hub.groups.${group.id}`}>{t(`hub.groups.${group.id}`)}</h6>
                {shownTools(group).map((tool) => (
                  <a href={`${base}${tool.path}`}><span class="tool-icon" set:html={tool.icon} />{tool.name}</a>
                ))}
              </nav>
            ))}
            <nav>
              <h6 class="soon-label" data-i18n="hub.comingSoon">{t('hub.comingSoon')}</h6>
              {COMING_SOON.map((item) => (
                <span class="soon"><span class="tool-icon" set:html={item.icon} /><span data-i18n={`hub.coming.${item.id}.title`}>{t(`hub.coming.${item.id}.title`)}</span></span>
              ))}
            </nav>
            <nav>
              <h6 data-i18n="common.builtWith">{t('common.builtWith')}</h6>
              {CREDITS.map((c) => <a href={c.url} target="_blank" rel="noopener">{c.name}</a>)}
            </nav>
          </div>
          <div class="footer-bottom mx-auto max-w-6xl px-4 pb-8 lg:px-8">
            <span>© {year} {HUB.name} · <span data-i18n="common.madeBy">{t('common.madeBy')}</span> <a href={HUB.ownerUrl} target="_blank" rel="noopener">{HUB.owner}</a> · <span data-i18n="common.rights">{t('common.rights')}</span></span>
            <span class="footer-social">
              {MENU_LINKS.map((l) => <a href={l.url} target="_blank" rel="noopener" title={l.name} aria-label={l.name} set:html={l.icon} />)}
            </span>
          </div>
        </footer>
      </div>

      <!-- ============ side menu ============ -->
      <div class="drawer-side z-40">
        <label for="nav" aria-label={t('common.closeMenu')} data-i18n-attr="aria-label:common.closeMenu" class="drawer-overlay"></label>
        <aside id="side-menu" class="side-menu frost flex min-h-full w-64 flex-col gap-2 border-y-0 border-l-0 p-4" data-anim="side">
          <a href={base} class="hub-brand">
            <span class="sgoi-badge" aria-hidden="true">{letters.map((c, i) => <i style={`--i:${i}`}>{c}</i>)}</span>
            <span class="min-w-0">
              <span class="brand-gradient block text-lg font-extrabold leading-tight">{nameRest}</span>
              <span class="block text-xs opacity-60" data-i18n="common.by" data-i18n-vars={by}>{t('common.by', { owner: HUB.owner })}</span>
            </span>
          </a>

          {sideMenu().map((item) =>
            'branch' in item ? (
              <SideBranch branch={item.branch} active={active} />
            ) : (
            <Fragment>
              <div class="px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-widest opacity-50" data-i18n={`hub.groups.${item.group.id}`}>{t(`hub.groups.${item.group.id}`)}</div>
              <ul class="menu w-full gap-1 p-0">
                {shownTools(item.group).map((tool) => (
                  <li>
                    <a
                      href={`${base}${tool.path}`}
                      class:list={{ 'menu-active': isActive(tool, active) }}
                      aria-current={tool.id === active ? 'page' : undefined}
                      title={t(`hub.tools.${tool.id}.blurb`)}
                      data-i18n-attr={`title:hub.tools.${tool.id}.blurb`}
                    >
                      <span class="tool-icon" set:html={tool.icon} />
                      {tool.name}
                    </a>
                  </li>
                ))}
              </ul>
            </Fragment>
            ),
          )}

          <!-- coming soon (not links yet) -->
          <div class="soon-label px-3 pb-1 pt-3 text-xs font-bold uppercase tracking-widest" data-i18n="hub.comingSoon">{t('hub.comingSoon')}</div>
          <ul class="side-soon-list">
            {COMING_SOON.map((item) => (
              <li class="side-soon">
                <span class="tool-icon" set:html={item.icon} />
                <span data-i18n={`hub.coming.${item.id}.title`}>{t(`hub.coming.${item.id}.title`)}</span>
                <span class="soon-badge" data-i18n="hub.soon">{t('hub.soon')}</span>
              </li>
            ))}
          </ul>

          <!-- same links on every page, pinned to the bottom right above the tip -->
          <ul class="menu mt-auto w-full gap-1 p-0">
            {MENU_LINKS.map((l) => (
              <li>
                <a href={l.url} target="_blank" rel="noopener"><span class="tool-icon" set:html={l.icon} />{l.name}</a>
              </li>
            ))}
          </ul>

          <div class="side-tip rounded-box bg-base-100/60 p-4 text-xs opacity-70" data-i18n-html="common.tip" set:html={t('common.tip')} />
        </aside>
      </div>
    </div>

    <!-- side menu collapse / expand, centred on the menu's right edge -->
    <!-- phones and tablets: animated hamburger that opens the side menu. Outside the
         header so it stays on top of the open menu (it becomes the X on its edge). -->
    <button id="side-toggle" type="button" class="hamburger" aria-controls="side-menu" aria-expanded="false" aria-label={t('common.openMenu')} title={t('common.openMenu')}>
      <span></span><span></span><span></span>
    </button>

    <slot name="after" />

    <script>
      import '../scripts/i18n.ts';
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
